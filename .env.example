# Optional - Slack (run: hermesv2 slack)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...   # for Socket Mode
SLACK_SIGNING_SECRET=

# Optional - Discord (run: hermesv2 discord)
DISCORD_BOT_TOKEN=

# NO ANTHROPIC_API_KEY NEEDED.
# Hermes v2 authenticates through the local `claude` CLI, which uses your
# Claude Max (or Pro) subscription via OAuth. Get logged in once with:
#     claude login
