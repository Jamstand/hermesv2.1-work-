# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional - Slack (run: hermesv2 slack)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...   # for Socket Mode
SLACK_SIGNING_SECRET=

# Optional - Discord (run: hermesv2 discord)
DISCORD_BOT_TOKEN=

# Optional - SMTP for sending email via the send_email tool
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional - IMAP for reading inbox via the read_inbox tool
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
